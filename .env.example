# Copia este archivo a .env  (o mejor: ejecuta ./deploy/scripts/gen-secrets.sh, que lo crea con contraseñas aleatorias).
# NUNCA subas .env a Git.

# --- Dirección pública ---------------------------------------------------------------------
# Con dominio público (certificado automático de Let's Encrypt; los puertos 80 y 443 deben llegar a este servidor):
#   SITE_ADDRESS=labores.tuempresa.com
#   PUBLIC_URL=https://labores.tuempresa.com
#   TLS_DIRECTIVE=
# Solo red interna (Caddy emite un certificado con su propia CA; ver docs/DESPLIEGUE.md para confiar en ella):
SITE_ADDRESS=labores.empresa.local
PUBLIC_URL=https://labores.empresa.local
TLS_DIRECTIVE=tls internal

# --- Base de datos ---------------------------------------------------------------------------
DB_NAME=labores
DB_OWNER_USER=labores_owner
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=

# --- Primer administrador (solo se usa si no existe ningún usuario) -------------------------------
BOOTSTRAP_ADMIN_EMAIL=admin@tuempresa.com
BOOTSTRAP_ADMIN_PASSWORD=
# Tras el primer arranque borra BOOTSTRAP_ADMIN_PASSWORD de este archivo.

# --- Correo (invitaciones y restablecer contraseña). Vacío = el administrador recibe el enlace en pantalla.
# Ejemplo: smtps://usuario:clave@smtp.tuproveedor.com:465
SMTP_URL=
MAIL_FROM=Control de Labores <no-reply@tuempresa.com>

# --- Opcionales ---------------------------------------------------------------------------------
MAX_UPLOAD_MB=10
SESSION_TTL_HOURS=168
LOG_LEVEL=info
HTTP_PORT=80
HTTPS_PORT=443
