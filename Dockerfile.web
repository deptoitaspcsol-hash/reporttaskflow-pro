# Interfaz (React) + servidor web Caddy con HTTPS automático y cabeceras de seguridad.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY . .
# La versión autoalojada habla con /api (la API propia), no con Base44.
ENV VITE_BACKEND=selfhosted
RUN npm run build

FROM caddy:2-alpine
COPY --from=build /app/dist /srv
COPY deploy/Caddyfile /etc/caddy/Caddyfile
EXPOSE 80 443 443/udp
